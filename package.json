{
  "name": "unsloth-lora-checkpoint-versioning",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @unsloth-lora-checkpoint-versioning/web dev",
    "dev:api": "cd services/api && .venv/bin/uvicorn main:app --reload --port ${API_PORT:-8000}",
    "build": "pnpm --filter @unsloth-lora-checkpoint-versioning/web build",
    "typecheck": "pnpm --filter @unsloth-lora-checkpoint-versioning/web typecheck",
    "contract:export": "services/api/.venv/bin/python services/api/scripts/export_openapi.py",
    "contract:check": "services/api/.venv/bin/python services/api/scripts/export_openapi.py --check && pnpm --filter @unsloth-lora-checkpoint-versioning/web exec vitest run src/lib/api-contract.test.ts",
    "check:agent-docs": "node scripts/check-agent-docs.mjs",
    "verify": "pnpm check:agent-docs && pnpm verify:api && pnpm verify:web",
    "verify:api": "pnpm lint:api && pnpm test:api && pnpm check:structure",
    "verify:web": "pnpm lint && pnpm test:web && pnpm build",
    "verify:full": "pnpm run doctor && pnpm verify && pnpm test:e2e",
    "lint": "pnpm --filter @unsloth-lora-checkpoint-versioning/web lint",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:web": "pnpm --filter @unsloth-lora-checkpoint-versioning/web test",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "test:e2e": "pnpm --filter @unsloth-lora-checkpoint-versioning/web exec playwright test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.15",
      "body-parser": "2.3.0",
      "@isaacs/brace-expansion": "5.0.9",
      "esbuild": "0.25.0",
      "express-rate-limit": "8.2.2",
      "fast-uri": "3.1.5",
      "flatted": "3.4.2",
      "hono": "4.12.34",
      "ip-address": "10.3.1",
      "js-yaml": "4.3.1",
      "lodash": "4.18.0",
      "nanoid": "3.3.18",
      "path-to-regexp": "8.4.0",
      "picomatch": "4.0.4",
      "postcss": "8.5.23",
      "postcss-selector-parser": "7.1.3",
      "qs": "6.15.2",
      "shell-quote": "1.9.0",
      "sharp": "0.35.3",
      "vite": "6.4.3",
      "vitest": "3.2.6",
      "@babel/core": "7.29.6",
      "ajv@^6": "6.14.0",
      "ajv@^8": "8.18.0",
      "brace-expansion@^1": "1.1.18",
      "brace-expansion@^2": "2.1.4",
      "minimatch@^3": "3.1.4",
      "minimatch@^9": "9.0.7",
      "minimatch@^10": "10.2.3"
    }
  }
}
