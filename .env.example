# Backblaze B2 (required) — standardized S3-compatible credentials.
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# Region drives the S3 endpoint (https://s3.<region>.backblazeb2.com).
B2_REGION=your_b2_region

# Optional public base URL for a public bucket. Leave unset for a private
# bucket — the app builds presigned download links instead.
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.us-west-004.backblazeb2.com

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=00example-key-id
# B2_APPLICATION_KEY=example-application-key-not-a-real-secret
# B2_BUCKET_NAME=my-lora-artifacts
# B2_REGION=us-west-004

# Fine-tuning is fully LOCAL — no external AI provider key is needed. GPU is
# optional: with a CUDA GPU the sample runs a real Unsloth LoRA/QLoRA fine-tune;
# with no GPU it falls back to a real (but tiny) transformers + PEFT LoRA
# fine-tune on CPU. Apple Silicon uses the CPU path (Unsloth has no MPS build).
#
# Optional Hugging Face token — only needed to pull GATED base models
# (Llama 3.x, Gemma), which also require a CUDA GPU. The default CPU-demo and
# Qwen models are ungated, so the demo needs no token.
# HF_TOKEN=your_hf_token

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
